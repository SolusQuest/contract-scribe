{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solusquest.dev/contract-scribe/documentation-patch/v1.request.schema.json",
  "title": "ContractScribe Patch Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["patchRequestVersion", "context", "provenanceCatalog", "blocks"],
  "properties": {
    "patchRequestVersion": { "const": 1 },
    "context": { "$ref": "#/$defs/context" },
    "provenanceCatalog": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryContextRef", "inputIdentity", "targetProfile"],
      "properties": {
        "repositoryContextRef": {
          "type": "string",
          "pattern": "^repoctx-[0-9a-f]{32}$"
        },
        "inputIdentity": { "$ref": "#/$defs/repositoryPath" },
        "targetProfile": {
          "enum": ["profile.external-api", "profile.assembly-visible"]
        }
      }
    },
    "symbolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilationContextRef", "documentationCommentId"],
      "properties": {
        "compilationContextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "documentationCommentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "end": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "repositoryLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "originalFileSha256", "encoding", "declarationSpan"],
      "properties": {
        "kind": { "const": "repository" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "originalFileSha256": { "$ref": "#/$defs/sha256" },
        "encoding": {
          "enum": ["utf-8", "utf-8-bom", "utf-16le-bom", "utf-16be-bom"]
        },
        "declarationSpan": { "$ref": "#/$defs/span" }
      }
    },
    "sourceGeneratorLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerId", "outputId", "sourceSha256", "declarationSpan"],
      "properties": {
        "kind": { "const": "sourceGenerator" },
        "producerId": { "type": "string", "pattern": "^sgp\\.[0-9a-f]{64}$" },
        "outputId": { "type": "string", "pattern": "^sgo\\.[0-9a-f]{64}$" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "declarationSpan": { "$ref": "#/$defs/span" }
      }
    },
    "toolGeneratedLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerId", "outputId", "sourceSha256", "declarationSpan"],
      "properties": {
        "kind": { "const": "toolGenerated" },
        "producerId": { "type": "string", "pattern": "^tgp\\.[0-9a-f]{64}$" },
        "outputId": { "type": "string", "pattern": "^tgo\\.[0-9a-f]{64}$" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "declarationSpan": { "$ref": "#/$defs/span" }
      }
    },
    "locator": {
      "oneOf": [
        { "$ref": "#/$defs/repositoryLocator" },
        { "$ref": "#/$defs/sourceGeneratorLocator" },
        { "$ref": "#/$defs/toolGeneratedLocator" }
      ]
    },
    "namedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "name"],
      "properties": {
        "kind": { "enum": ["typeParameter", "parameter"] },
        "identity": {
          "type": "string",
          "pattern": "^(?:type-parameter|parameter)/(?:0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "typeParameter" } } },
          "then": { "properties": { "identity": { "pattern": "^type-parameter/(?:0|[1-9][0-9]*)$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "parameter" } } },
          "then": { "properties": { "identity": { "pattern": "^parameter/(?:0|[1-9][0-9]*)$" } } }
        }
      ]
    },
    "unnamedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["return", "value"] },
        "identity": { "enum": ["return", "value"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "return" } } },
          "then": { "properties": { "identity": { "const": "return" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "value" } } },
          "then": { "properties": { "identity": { "const": "value" } } }
        }
      ]
    },
    "component": {
      "oneOf": [
        { "$ref": "#/$defs/namedComponent" },
        { "$ref": "#/$defs/unnamedComponent" }
      ]
    },
    "logicalLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]*$"
      }
    },
    "namedContentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentIdentity", "name", "lines"],
      "properties": {
        "componentIdentity": {
          "type": "string",
          "pattern": "^(?:type-parameter|parameter)/(?:0|[1-9][0-9]*)$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lines": { "$ref": "#/$defs/logicalLines" }
      }
    },
    "unnamedContentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentIdentity", "lines"],
      "properties": {
        "componentIdentity": { "enum": ["return", "value"] },
        "lines": { "$ref": "#/$defs/logicalLines" }
      }
    },
    "exceptionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeDocumentationId", "lines"],
      "properties": {
        "typeDocumentationId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024,
          "pattern": "^T:[^\\s<>&\"']+$"
        },
        "lines": { "$ref": "#/$defs/logicalLines" }
      }
    },
    "structuredContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summaryLines", "typeParameters", "parameters", "return", "value", "exceptions", "remarksLines"],
      "properties": {
        "kind": { "const": "structured" },
        "summaryLines": { "$ref": "#/$defs/logicalLines" },
        "typeParameters": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/namedContentEntry" },
              { "properties": { "componentIdentity": { "pattern": "^type-parameter/(?:0|[1-9][0-9]*)$" } } }
            ]
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/namedContentEntry" },
              { "properties": { "componentIdentity": { "pattern": "^parameter/(?:0|[1-9][0-9]*)$" } } }
            ]
          }
        },
        "return": {
          "oneOf": [
            { "type": "null" },
            {
              "allOf": [
                { "$ref": "#/$defs/unnamedContentEntry" },
                { "properties": { "componentIdentity": { "const": "return" } } }
              ]
            }
          ]
        },
        "value": {
          "oneOf": [
            { "type": "null" },
            {
              "allOf": [
                { "$ref": "#/$defs/unnamedContentEntry" },
                { "properties": { "componentIdentity": { "const": "value" } } }
              ]
            }
          ]
        },
        "exceptions": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/exceptionEntry" }
        },
        "remarksLines": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/logicalLines" }
          ]
        }
      }
    },
    "inheritDocContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "inheritDoc" }
      }
    },
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/structuredContent" },
        { "$ref": "#/$defs/inheritDocContent" }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "symbolRef", "locator", "editKind", "applicableComponents", "content", "provenanceRefs"],
      "properties": {
        "blockId": { "$ref": "#/$defs/opaqueId" },
        "symbolRef": { "$ref": "#/$defs/symbolRef" },
        "locator": { "$ref": "#/$defs/locator" },
        "editKind": { "enum": ["insert", "replace"] },
        "applicableComponents": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/component" }
        },
        "content": { "$ref": "#/$defs/content" },
        "provenanceRefs": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/opaqueId" }
        }
      }
    }
  }
}
