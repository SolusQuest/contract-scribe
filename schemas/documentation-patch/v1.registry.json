  "diagnosticSelection": {
    "maximum": 128,
    "rootContextPrecedence": [
      "patch.stale.repository-context",
      "patch.stale.input-identity",
      "patch.stale.target-profile"
    ],
    "perBlockStalePrecedence": [
      "patch.stale.compilation-context",
      "patch.stale.source-encoding",
      "patch.stale.source-bytes",
      "patch.stale.source-span"
    ],
    "perBlockRejectedPrecedence": [
      "patch.rejected.unsupported-target",
      "patch.rejected.ambiguous-target",
      "patch.rejected.non-writable-target",
      "patch.rejected.edit-state",
      "patch.rejected.unsafe-change"
    ],
    "rule": "Choose root stale failures in repository-context, input-identity, target-profile order; otherwise choose stale then rejected failures in request block order and the closed code precedence. Retain that primary diagnostic, then unique secondary diagnostics in ordinal order by code, blockId, path, and pointer until the maximum is reached."
  }
