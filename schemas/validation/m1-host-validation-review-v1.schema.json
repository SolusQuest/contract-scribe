{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SolusQuest/contract-scribe/schemas/validation/m1-host-validation-review-v1.schema.json",
  "type": "object",
  "required": [
    "formatVersion",
    "reviewId",
    "bundleId",
    "reviewedHead",
    "reviewerKind",
    "relaySessionId",
    "relayTaskId",
    "verdict",
    "blockingFindingIds",
    "reviewedAtUtc"
  ],
  "properties": {
    "formatVersion": {
      "const": "contractscribe-m1-host-validation-review-v1"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^review\\.[0-9a-f]{64}$"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^m1hvp1\\.[0-9a-f]{64}$"
    },
    "reviewedHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewerKind": {
      "const": "independent-relay"
    },
    "relaySessionId": {
      "type": "string",
      "format": "uuid"
    },
    "relayTaskId": {
      "type": "string",
      "format": "uuid"
    },
    "verdict": {
      "enum": [
        "pending",
        "accepted"
      ]
    },
    "blockingFindingIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "reviewedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
