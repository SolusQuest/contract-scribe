{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SolusQuest/contract-scribe/schemas/validation/m1-host-validation-protocol-v1.schema.json",
  "type": "object",
  "required": [
    "formatVersion",
    "protocolId",
    "baseline",
    "artifactInventory",
    "requiredCells",
    "subjectSourceContract",
    "taxonomies",
    "executionContract",
    "publicSafety",
    "networkEvidenceProfile",
    "requiredValidators"
  ],
  "properties": {
    "formatVersion": {
      "const": "contractscribe-m1-host-validation-protocol-v1"
    },
    "protocolId": {
      "const": "m1-host-validation-v1"
    },
    "baseline": {
      "type": "object",
      "required": [
        "coordinatingIssue",
        "disposition",
        "mergeCommit",
        "contractManifest",
        "contractManifestSha256",
        "predecessor"
      ],
      "properties": {
        "coordinatingIssue": {
          "const": "https://github.com/SolusQuest/contract-scribe/issues/55"
        },
        "disposition": {
          "enum": [
            "pending-main-reconciliation",
            "main-reachable"
          ]
        },
        "mergeCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractManifest": {
          "const": "tests/fixtures/m1-contract-baseline/v1/manifest.json"
        },
        "contractManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "predecessor": {
          "type": "object",
          "required": [
            "coordinatingIssue",
            "contractRevision",
            "mergeCommit",
            "contractManifest",
            "contractManifestSha256"
          ],
          "properties": {
            "coordinatingIssue": {
              "const": "https://github.com/SolusQuest/contract-scribe/issues/35"
            },
            "contractRevision": {
              "const": "issue-35-pre-release-v1"
            },
            "mergeCommit": {
              "const": "bb4654edc180e2953dda6b89a29211b18778b78e"
            },
            "contractManifest": {
              "const": "tests/fixtures/m1-contract-baseline/v1/manifest.json"
            },
            "contractManifestSha256": {
              "const": "2872387ce9cfd8578c8f473ec26ab9f10dd44381edfbc0248e6fa370d797ab31"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "pending-main-reconciliation"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "mergeCommit": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "mergeCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      ]
    },
    "artifactInventory": {
      "type": "array",
      "minItems": 20,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "requiredCells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/ubuntuCell"
        },
        {
          "$ref": "#/$defs/windowsCell"
        }
      ],
      "items": false
    },
    "subjectSourceContract": {
      "type": "object",
      "required": [
        "sourceRoots",
        "failureRegistry",
        "calibratedBounds",
        "buildRecipe",
        "commandContract",
        "contractBaseline",
        "environmentPolicy",
        "workflow"
      ],
      "properties": {
        "sourceRoots": {
          "const": [
            "ContractScribe.slnx",
            "Directory.Build.props",
            "Directory.Packages.props",
            "global.json",
            "src"
          ]
        },
        "failureRegistry": {
          "const": "src/ContractScribe.Core/Hosting/host-failure-registry-v1.json"
        },
        "calibratedBounds": {
          "const": "src/ContractScribe.Core/Hosting/host-calibrated-bounds-v1.json"
        },
        "buildRecipe": {
          "const": "Directory.Build.props"
        },
        "commandContract": {
          "const": "schemas/validation/m1-host-validation-subject-v1.schema.json"
        },
        "contractBaseline": {
          "const": "tests/fixtures/m1-contract-baseline/v1/manifest.json"
        },
        "environmentPolicy": {
          "const": "docs/20_architecture/security-boundary.md"
        },
        "workflow": {
          "const": ".github/workflows/ci.yml"
        }
      },
      "additionalProperties": false
    },
    "taxonomies": {
      "type": "object",
      "required": [
        "processStart",
        "processTermination",
        "auditOutcome",
        "executionOutcome",
        "vectorVerdict",
        "validationOutcome",
        "validationPrecedence",
        "enforcementClass"
      ],
      "properties": {
        "processStart": {
          "const": [
            "started",
            "launch-failure",
            "runtime-load-failure",
            "permission-failure",
            "startup-timeout"
          ]
        },
        "processTermination": {
          "const": [
            "normal",
            "crash",
            "abort",
            "external-kill",
            "out-of-memory",
            "stack-overflow",
            "fatal-runtime-termination",
            "not-started"
          ]
        },
        "auditOutcome": {
          "const": [
            "compliant",
            "violation",
            "skipped"
          ]
        },
        "executionOutcome": {
          "const": [
            "invalid-input",
            "environment-unavailable",
            "load-failure",
            "audit-error",
            "publication-failure",
            "cancelled",
            "timeout",
            "succeeded"
          ]
        },
        "vectorVerdict": {
          "const": [
            "matched",
            "subject-nonconformance",
            "vector-environment-blocked",
            "vector-infrastructure-incomplete",
            "protocol-invalid-observation"
          ]
        },
        "validationOutcome": {
          "const": [
            "protected-input-invalidated",
            "protocol-failure",
            "subject-nonconformance",
            "environment-or-infrastructure-incomplete",
            "harness-or-ci-cancelled",
            "harness-or-ci-timed-out",
            "passed"
          ]
        },
        "validationPrecedence": {
          "const": [
            "protected-input-invalidated",
            "protocol-failure",
            "subject-nonconformance",
            "environment-or-infrastructure-incomplete",
            "harness-or-ci-cancelled",
            "harness-or-ci-timed-out",
            "passed"
          ]
        },
        "enforcementClass": {
          "const": [
            "internally-enforceable",
            "caller-or-os-enforced",
            "observable-only",
            "not-enforceable-selected-topology"
          ]
        }
      },
      "additionalProperties": false
    },
    "executionContract": {
      "type": "object",
      "required": [
        "adapterVersion",
        "requestEncoding",
        "responseEncoding",
        "standardOutputByteLimit",
        "standardErrorByteLimit",
        "responseByteLimit",
        "evidenceByteLimit",
        "subjectTimeoutSeconds",
        "retryPolicy",
        "repositoryObserverClaim",
        "processObserverClaim"
      ],
      "properties": {
        "adapterVersion": {
          "const": "contractscribe-m1-host-validation-subject-v1"
        },
        "requestEncoding": {
          "const": "canonical-json-utf8-no-bom-single-lf"
        },
        "responseEncoding": {
          "const": "canonical-json-utf8-no-bom-single-lf"
        },
        "standardOutputByteLimit": {
          "const": 65536
        },
        "standardErrorByteLimit": {
          "const": 65536
        },
        "responseByteLimit": {
          "const": 262144
        },
        "evidenceByteLimit": {
          "const": 4194304
        },
        "subjectTimeoutSeconds": {
          "const": 30
        },
        "retryPolicy": {
          "const": "unrecorded-retries-forbidden-new-attempt-required"
        },
        "repositoryObserverClaim": {
          "const": "detection-only-no-prevention-rollback-transient-capture-or-sandbox"
        },
        "processObserverClaim": {
          "const": "bounded-descendant-detection-only-no-process-isolation"
        }
      },
      "additionalProperties": false
    },
    "publicSafety": {
      "type": "object",
      "required": [
        "networkClaimSetId",
        "networkClaimSetMembers",
        "prohibitedClaims",
        "publicArtifactAllowlist",
        "stableDiagnosticCodes"
      ],
      "properties": {
        "networkClaimSetId": {
          "const": "m1.network-behavior-and-bounded-evidence-claims.v1"
        },
        "networkClaimSetMembers": {
          "const": [
            {
              "claimId": "m1.no-declared-network-operation.no-contractscribe-initiation.v1",
              "text": "The deterministic audit declares no network-dependent operation, and ContractScribe initiates no provider, GitHub, update, telemetry, restore, runtime-download, or other declared network-dependent operation."
            },
            {
              "claimId": "m1.exact-revision-bounded-network-conformance.v1",
              "text": "The recorded evidence is bounded to one exact reviewed production revision and the frozen checks."
            },
            {
              "claimId": "m1.no-egress-sandbox-or-adversarial-completeness.v1",
              "text": "The recorded evidence does not establish egress isolation, sandboxing, capability security, secret isolation from repository-controlled build logic, whole-program non-reachability, or the absence of every possible network path in arbitrary or adversarial .NET code. Repository-controlled MSBuild targets, analyzers, generators, and SDK logic execute as trusted input with caller privileges and are outside this ContractScribe behavior claim."
            }
          ]
        },
        "prohibitedClaims": {
          "const": [
            "network-isolation-enforced",
            "offline-sandbox",
            "untrusted-msbuild-sandboxed",
            "transient-writes-prevented"
          ]
        },
        "publicArtifactAllowlist": {
          "const": [
            "cell-evidence.json",
            "aggregate-evidence.json",
            "incomplete-evidence.json",
            "publication-record.json"
          ]
        },
        "stableDiagnosticCodes": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^HV[0-9]{3}(?:_[A-Z0-9_]+)?$",
            "maxLength": 64
          }
        }
      },
      "additionalProperties": false
    },
    "networkEvidenceProfile": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "tests/fixtures/m1-host-validation/v1/network-evidence-profile.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "requiredValidators": {
      "const": [
        "bundle.identity",
        "bundle.inventory",
        "bundle.schema",
        "crosswalk.bidirectional",
        "evidence.canonical",
        "evidence.execution-set",
        "evidence.public-safety",
        "evidence.review-binding",
        "evidence.incomplete-retention",
        "evidence.network-bounded-profile",
        "execution.stream-boundary",
        "execution.vector-runner",
        "observer.process-tree",
        "observer.repository-delta",
        "observer.temporary-disk-high-water",
        "observer.native-termination-cause",
        "project.boundary",
        "subject.materialization",
        "validation.attempt-identity"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$"
    },
    "ubuntuCell": {
      "type": "object",
      "required": [
        "cellId",
        "runnerOs",
        "architecture",
        "rid",
        "runnerImagePolicy"
      ],
      "properties": {
        "cellId": {
          "const": "ubuntu-x64"
        },
        "runnerOs": {
          "const": "ubuntu"
        },
        "architecture": {
          "const": "X64"
        },
        "rid": {
          "const": "linux-x64"
        },
        "runnerImagePolicy": {
          "const": "github-hosted-ubuntu-latest-record-concrete-image"
        }
      },
      "additionalProperties": false
    },
    "windowsCell": {
      "type": "object",
      "required": [
        "cellId",
        "runnerOs",
        "architecture",
        "rid",
        "runnerImagePolicy"
      ],
      "properties": {
        "cellId": {
          "const": "windows-x64"
        },
        "runnerOs": {
          "const": "windows"
        },
        "architecture": {
          "const": "X64"
        },
        "rid": {
          "const": "win-x64"
        },
        "runnerImagePolicy": {
          "const": "github-hosted-windows-latest-record-concrete-image"
        }
      },
      "additionalProperties": false
    }
  }
}
