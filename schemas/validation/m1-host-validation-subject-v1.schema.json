{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SolusQuest/contract-scribe/schemas/validation/m1-host-validation-subject-v1.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/productionSubject"
    },
    {
      "$ref": "#/$defs/selfTestSubject"
    },
    {
      "$ref": "#/$defs/commonSourceManifest"
    },
    {
      "$ref": "#/$defs/cellSubjectManifest"
    }
  ],
  "$defs": {
    "baseSubject": {
      "type": "object",
      "required": [
        "formatVersion",
        "subjectKind",
        "adapterVersion",
        "entryPoint",
        "implementationOwner",
        "allowedForProductionEvidence",
        "requestSchema",
        "responseSchema",
        "controlContract",
        "networkOperationRecorderContract",
        "temporaryDiskRetentionContract",
        "processContract"
      ],
      "properties": {
        "formatVersion": {
          "const": "contractscribe-m1-host-validation-subject-descriptor-v1"
        },
        "subjectKind": {
          "enum": [
            "production-host",
            "self-test"
          ]
        },
        "adapterVersion": {
          "const": "contractscribe-m1-host-validation-subject-v1"
        },
        "entryPoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "implementationOwner": {
          "enum": [
            "issue-24",
            "issue-26"
          ]
        },
        "allowedForProductionEvidence": {
          "type": "boolean"
        },
        "requestSchema": {
          "const": "contractscribe-m1-host-validation-subject-request-v1"
        },
        "responseSchema": {
          "const": "contractscribe-m1-host-validation-subject-response-v1"
        },
        "controlContract": {
          "type": "object",
          "required": [
            "namedSynchronizationGates",
            "controlActions",
            "shellAllowed"
          ],
          "properties": {
            "namedSynchronizationGates": {
              "const": true
            },
            "controlActions": {
              "const": [
                "continue",
                "cancel",
                "external-kill",
                "measure-temporary-disk",
                "release-late-completion",
                "observe"
              ]
            },
            "shellAllowed": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "networkOperationRecorderContract": {
          "type": "object",
          "required": [
            "formatVersion",
            "activationRecord",
            "harnessOwnedPath",
            "productOwnedSeamsRequired"
          ],
          "properties": {
            "activationRecord": {
              "const": "{\"formatVersion\":\"contractscribe-network-operation-recorder-v1\",\"state\":\"active\"}"
            },
            "formatVersion": {
              "const": "contractscribe-network-operation-recorder-v1"
            },
            "harnessOwnedPath": {
              "const": true
            },
            "productOwnedSeamsRequired": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "temporaryDiskRetentionContract": {
          "type": "object",
          "required": [
            "gate",
            "retainUntilRelease",
            "cleanupBeforeGateAllowed",
            "freezeBoundary",
            "releaseBoundary"
          ],
          "properties": {
            "gate": {
              "const": "temporary-disk-high-water"
            },
            "retainUntilRelease": {
              "const": true
            },
            "cleanupBeforeGateAllowed": {
              "const": false
            },
            "freezeBoundary": {
              "const": "subject-sentinel-in-each-governed-root-before-control-gate"
            },
            "releaseBoundary": {
              "const": "subject-sentinel-in-each-governed-root-before-post-release-mutation"
            }
          },
          "additionalProperties": false
        },
        "processContract": {
          "type": "object",
          "required": [
            "requestArgument",
            "responseArgument",
            "workingDirectory",
            "stdoutOwnership",
            "stderrOwnership"
          ],
          "properties": {
            "requestArgument": {
              "const": "--request"
            },
            "responseArgument": {
              "const": "--response"
            },
            "workingDirectory": {
              "const": "repository-root"
            },
            "stdoutOwnership": {
              "const": "harness-redirected-bounded-never-echoed"
            },
            "stderrOwnership": {
              "const": "harness-redirected-bounded-never-echoed"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "productionSubject": {
      "allOf": [
        {
          "$ref": "#/$defs/baseSubject"
        },
        {
          "properties": {
            "subjectKind": {
              "const": "production-host"
            },
            "entryPoint": {
              "const": "prebuilt-in-process-test-entrypoint"
            },
            "implementationOwner": {
              "const": "issue-24"
            },
            "allowedForProductionEvidence": {
              "const": true
            }
          }
        }
      ]
    },
    "selfTestSubject": {
      "allOf": [
        {
          "$ref": "#/$defs/baseSubject"
        },
        {
          "properties": {
            "subjectKind": {
              "const": "self-test"
            },
            "entryPoint": {
              "const": "tests/ContractScribe.HostValidation/fake-subject"
            },
            "implementationOwner": {
              "const": "issue-26"
            },
            "allowedForProductionEvidence": {
              "const": false
            }
          }
        }
      ]
    },
    "sourceConfiguration": {
      "type": "object",
      "required": [
        "sourceConfigurationId",
        "hostRevision",
        "declaredOperationInventoryId",
        "sourceRoots",
        "sourceAndBuildInputs",
        "failureRegistry",
        "calibratedBounds",
        "buildRecipe",
        "commandContract",
        "contractBaseline",
        "environmentPolicy",
        "workflow"
      ],
      "properties": {
        "sourceConfigurationId": {
          "type": "string",
          "pattern": "^source\\.[0-9a-f]{64}$"
        },
        "hostRevision": {
          "$ref": "#/$defs/commit"
        },
        "declaredOperationInventoryId": {
          "type": "string",
          "pattern": "^operations\\.[0-9a-f]{64}$"
        },
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "sourceAndBuildInputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        },
        "failureRegistry": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "calibratedBounds": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "buildRecipe": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "commandContract": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "contractBaseline": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "environmentPolicy": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "workflow": {
          "$ref": "#/$defs/artifactIdentity"
        }
      },
      "additionalProperties": false
    },
    "executionCell": {
      "type": "object",
      "required": [
        "materialization",
        "launchKind",
        "entryPoint",
        "argumentPrefix",
        "fixtures"
      ],
      "properties": {
        "materialization": {
          "$ref": "#/$defs/materialization"
        },
        "launchKind": {
          "enum": [
            "apphost",
            "dotnet-dll"
          ]
        },
        "entryPoint": {
          "$ref": "#/$defs/repositoryPath"
        },
        "argumentPrefix": {
          "const": []
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/fixtureRealization"
          }
        }
      },
      "additionalProperties": false
    },
    "materialization": {
      "type": "object",
      "required": [
        "cellId",
        "workflowJobKey",
        "workflowRunUrl",
        "runnerImage",
        "rid",
        "architecture",
        "selectedSdk",
        "selectedRuntime",
        "selectedMsbuild",
        "productionArtifacts",
        "runtimeDependencies",
        "harnessArtifacts"
      ],
      "properties": {
        "cellId": {
          "enum": [
            "ubuntu-x64",
            "windows-x64"
          ]
        },
        "workflowJobKey": {
          "$ref": "#/$defs/safeToken"
        },
        "workflowRunUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 512
        },
        "runnerImage": {
          "$ref": "#/$defs/safeToken"
        },
        "rid": {
          "enum": [
            "linux-x64",
            "win-x64"
          ]
        },
        "architecture": {
          "const": "X64"
        },
        "selectedSdk": {
          "$ref": "#/$defs/safeToken"
        },
        "selectedRuntime": {
          "$ref": "#/$defs/safeToken"
        },
        "selectedMsbuild": {
          "$ref": "#/$defs/safeToken"
        },
        "productionArtifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        },
        "runtimeDependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        },
        "harnessArtifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        }
      },
      "additionalProperties": false
    },
    "fixtureRealization": {
      "type": "object",
      "required": [
        "vectorId",
        "executorKind",
        "repositoryRoot",
        "repositoryIdentitySha256",
        "capabilityAvailable",
        "blockedReasonCode",
        "executable",
        "arguments",
        "executableSha256",
        "arrangementInputs",
        "allowedDesignTimeRoots",
        "processObservationMode",
        "resultPath",
        "resultPrestate",
        "runWorkingDirectories",
        "externalCause"
      ],
      "properties": {
        "vectorId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
          "maxLength": 96
        },
        "executorKind": {
          "enum": [
            "production-host",
            "external-process",
            "platform-fixture"
          ]
        },
        "repositoryRoot": {
          "$ref": "#/$defs/repositoryPath"
        },
        "repositoryIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "capabilityAvailable": {
          "type": "boolean"
        },
        "blockedReasonCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^HV[0-9]{3}(?:_[A-Z0-9_]+)?$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "executable": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?:missing-executable|subject-entrypoint|dotnet|repository:(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:\\{request\\}|\\{response\\}|\\{repository\\}|\\{control\\}|repository:(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+)$"
          }
        },
        "executableSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrangementInputs": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        },
        "allowedDesignTimeRoots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "processObservationMode": {
          "enum": [
            "bounded-polling",
            "synchronized-tree"
          ]
        },
        "resultPath": {
          "anyOf": [
            {
              "$ref": "#/$defs/repositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultPrestate": {
          "enum": [
            "absent",
            "prior-valid",
            "stale-invalid"
          ]
        },
        "runWorkingDirectories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/runWorkingDirectory"
          }
        },
        "externalCause": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "out-of-memory",
            "stack-overflow",
            "abort",
            "fatal-runtime-termination",
            null
          ]
        },
        "processIdentityRegistry": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/processIdentityRule"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capabilityAvailable": {
                "const": true
              },
              "executorKind": {
                "enum": [
                  "external-process",
                  "platform-fixture"
                ]
              }
            },
            "required": [
              "capabilityAvailable",
              "executorKind"
            ]
          },
          "then": {
            "properties": {
              "executable": {
                "type": "string"
              },
              "arrangementInputs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executable": {
                "type": "string",
                "pattern": "^repository:"
              }
            },
            "required": [
              "executable"
            ]
          },
          "then": {
            "properties": {
              "executableSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilityAvailable": {
                "const": true
              }
            },
            "required": [
              "capabilityAvailable"
            ]
          },
          "then": {
            "required": [
              "processIdentityRegistry"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "runWorkingDirectory": {
      "type": "object",
      "required": [
        "runId",
        "mode"
      ],
      "properties": {
        "runId": {
          "enum": [
            "run-1",
            "run-2"
          ]
        },
        "mode": {
          "enum": [
            "repository-root",
            "system-temp"
          ]
        }
      },
      "additionalProperties": false
    },
    "processIdentityRule": {
      "type": "object",
      "required": [
        "fingerprintSha256",
        "artifactKind",
        "entryPointSha256"
      ],
      "properties": {
        "fingerprintSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactKind": {
          "enum": [
            "production-subject",
            "fixture-helper",
            "selected-toolchain"
          ]
        },
        "entryPointSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "artifactIdentity": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$"
    },
    "safeToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subjectRequest": {
      "type": "object",
      "required": [
        "formatVersion",
        "subjectKind",
        "vectorId",
        "runId",
        "repositoryRoot",
        "responsePath",
        "controlRoot",
        "synchronizationGates",
        "controlAction",
        "networkOperationLogPath",
        "transitionLogPath",
        "auditTemporaryRoot",
        "temporaryDiskGate",
        "publicationFault",
        "postTerminalAttempt"
      ],
      "properties": {
        "formatVersion": {
          "const": "contractscribe-m1-host-validation-subject-request-v1"
        },
        "subjectKind": {
          "enum": [
            "production-host",
            "self-test"
          ]
        },
        "vectorId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
          "maxLength": 96
        },
        "runId": {
          "enum": [
            "run-1",
            "run-2"
          ]
        },
        "repositoryRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "responsePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "controlRoot": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "synchronizationGates": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "enum": [
              "before-commit",
              "after-commit",
              "late-completion",
              "publication-before-commit",
              "publication-after-commit",
              "publication-staging-ready",
              "forced-termination",
              "process-observation",
              "temporary-disk-high-water"
            ]
          }
        },
        "controlAction": {
          "enum": [
            "continue",
            "cancel",
            "external-kill",
            "measure-temporary-disk",
            "release-late-completion",
            "observe"
          ]
        },
        "networkOperationLogPath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "transitionLogPath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "auditTemporaryRoot": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "temporaryDiskGate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "temporaryWorkRoot",
                "outputStagingRoot",
                "freezeSentinelName",
                "releaseSentinelName"
              ],
              "properties": {
                "temporaryWorkRoot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "outputStagingRoot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "freezeSentinelName": {
                  "type": "string",
                  "pattern": "^\\.contractscribe-hv-freeze-[a-f0-9]{32}$"
                },
                "releaseSentinelName": {
                  "type": "string",
                  "pattern": "^\\.contractscribe-hv-release-[a-f0-9]{32}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "publicationFault": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "operation",
                "occurrence",
                "failure",
                "stagingRelativePath"
              ],
              "properties": {
                "operation": {
                  "enum": [
                    "invalidate-existing",
                    "atomic-replace"
                  ]
                },
                "occurrence": {
                  "const": 1
                },
                "failure": {
                  "const": "io-exception"
                },
                "stagingRelativePath": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "TestResults/.audit-result.json.contractscribe-stage",
                    null
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "postTerminalAttempt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "executionOutcome",
                "timing",
                "occurrence"
              ],
              "properties": {
                "executionOutcome": {
                  "const": "succeeded"
                },
                "timing": {
                  "const": "after-publication-failure-commit"
                },
                "occurrence": {
                  "const": 1
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "controlAction": {
                "const": "measure-temporary-disk"
              }
            },
            "required": [
              "controlAction"
            ]
          },
          "then": {
            "properties": {
              "auditTemporaryRoot": {
                "type": "string"
              },
              "temporaryDiskGate": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "temporaryDiskGate": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "vectorId": {
                "const": "failure.publication-invalidation"
              }
            },
            "required": [
              "vectorId"
            ]
          },
          "then": {
            "properties": {
              "publicationFault": {
                "const": {
                  "operation": "invalidate-existing",
                  "occurrence": 1,
                  "failure": "io-exception",
                  "stagingRelativePath": null
                }
              },
              "postTerminalAttempt": {
                "const": {
                  "executionOutcome": "succeeded",
                  "timing": "after-publication-failure-commit",
                  "occurrence": 1
                }
              },
              "synchronizationGates": {
                "const": []
              },
              "controlAction": {
                "const": "continue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "vectorId": {
                "const": "failure.publication-finalization"
              }
            },
            "required": [
              "vectorId"
            ]
          },
          "then": {
            "properties": {
              "publicationFault": {
                "const": {
                  "operation": "atomic-replace",
                  "occurrence": 1,
                  "failure": "io-exception",
                  "stagingRelativePath": "TestResults/.audit-result.json.contractscribe-stage"
                }
              },
              "postTerminalAttempt": {
                "const": {
                  "executionOutcome": "succeeded",
                  "timing": "after-publication-failure-commit",
                  "occurrence": 1
                }
              },
              "synchronizationGates": {
                "const": [
                  "publication-staging-ready"
                ]
              },
              "controlAction": {
                "const": "observe"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "vectorId": {
                "not": {
                  "enum": [
                    "failure.publication-invalidation",
                    "failure.publication-finalization"
                  ]
                }
              }
            },
            "required": [
              "vectorId"
            ]
          },
          "then": {
            "properties": {
              "publicationFault": {
                "type": "null"
              },
              "postTerminalAttempt": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "subjectResponse": {
      "type": "object",
      "required": [
        "formatVersion",
        "vectorId",
        "runId",
        "processStart",
        "processTermination",
        "auditOutcome",
        "executionOutcome",
        "failureRegistryIdentity",
        "failureCode",
        "failureStage",
        "terminalState",
        "artifactState",
        "enforcementClass",
        "observationCode",
        "canonicalResult",
        "hostFacts"
      ],
      "properties": {
        "formatVersion": {
          "const": "contractscribe-m1-host-validation-subject-response-v1"
        },
        "vectorId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
          "maxLength": 96
        },
        "runId": {
          "enum": [
            "run-1",
            "run-2"
          ]
        },
        "processStart": {
          "enum": [
            "started",
            "launch-failure",
            "runtime-load-failure",
            "permission-failure",
            "startup-timeout"
          ]
        },
        "processTermination": {
          "enum": [
            "normal",
            "crash",
            "abort",
            "external-kill",
            "out-of-memory",
            "stack-overflow",
            "fatal-runtime-termination",
            "not-started"
          ]
        },
        "auditOutcome": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "compliant",
            "violation",
            "skipped",
            null
          ]
        },
        "executionOutcome": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "invalid-input",
            "environment-unavailable",
            "load-failure",
            "audit-error",
            "publication-failure",
            "cancelled",
            "timeout",
            "succeeded",
            null
          ]
        },
        "failureRegistryIdentity": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
          "maxLength": 96
        },
        "failureStage": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 64
        },
        "terminalState": {
          "enum": [
            "not-entered",
            "pending",
            "committed",
            "rejected-late"
          ]
        },
        "artifactState": {
          "enum": [
            "absent",
            "invalidated",
            "staged",
            "published"
          ]
        },
        "enforcementClass": {
          "enum": [
            "internally-enforceable",
            "caller-or-os-enforced",
            "observable-only",
            "not-enforceable-selected-topology"
          ]
        },
        "observationCode": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
          "maxLength": 128
        },
        "canonicalResult": {
          "anyOf": [
            {
              "$ref": "#/$defs/canonicalResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "hostFacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/hostObservationFacts"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "invalid-input",
                  "environment-unavailable",
                  "load-failure",
                  "audit-error",
                  "publication-failure",
                  "cancelled",
                  "timeout"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failureRegistryIdentity": {
                "type": "string"
              },
              "failureCode": {
                "type": "string"
              },
              "failureStage": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "succeeded",
                  null
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failureRegistryIdentity": {
                "type": "null"
              },
              "failureCode": {
                "type": "null"
              },
              "failureStage": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "invalid-input",
                  "environment-unavailable"
                ]
              },
              "hostFacts": {
                "type": "object"
              }
            },
            "required": [
              "executionOutcome",
              "hostFacts"
            ]
          },
          "then": {
            "properties": {
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "not-selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "load-failure",
                  "audit-error",
                  "succeeded"
                ]
              },
              "hostFacts": {
                "type": "object"
              }
            },
            "required": [
              "executionOutcome",
              "hostFacts"
            ]
          },
          "then": {
            "properties": {
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "cancelled",
                  "timeout"
                ]
              }
            },
            "required": [
              "executionOutcome"
            ]
          },
          "then": {
            "properties": {
              "failureStage": {
                "enum": [
                  "input",
                  "environment",
                  "sdk-discovery",
                  "workspace-load",
                  "classification",
                  "documentation-observation",
                  "policy-evidence",
                  "audit",
                  "result-validation",
                  "publication",
                  "shutdown",
                  "internal"
                ]
              },
              "hostFacts": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "cancelled",
                  "timeout"
                ]
              },
              "failureStage": {
                "enum": [
                  "input",
                  "environment"
                ]
              }
            },
            "required": [
              "executionOutcome",
              "failureStage"
            ]
          },
          "then": {
            "properties": {
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "not-selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "enum": [
                  "cancelled",
                  "timeout"
                ]
              },
              "failureStage": {
                "enum": [
                  "workspace-load",
                  "classification",
                  "documentation-observation",
                  "policy-evidence",
                  "audit",
                  "result-validation",
                  "shutdown",
                  "internal"
                ]
              }
            },
            "required": [
              "executionOutcome",
              "failureStage"
            ]
          },
          "then": {
            "properties": {
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "vectorId": {
                "enum": [
                  "cancellation.before-commit",
                  "cancellation.after-commit",
                  "cancellation.late-completion",
                  "cancellation.terminal-precedence"
                ]
              }
            },
            "required": [
              "vectorId"
            ]
          },
          "then": {
            "properties": {
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "vectorId": {
                "const": "failure.publication-invalidation"
              }
            },
            "required": [
              "vectorId"
            ]
          },
          "then": {
            "properties": {
              "executionOutcome": {
                "const": "publication-failure"
              },
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "not-selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "vectorId": {
                "const": "failure.publication-finalization"
              }
            },
            "required": [
              "vectorId"
            ]
          },
          "then": {
            "properties": {
              "executionOutcome": {
                "const": "publication-failure"
              },
              "hostFacts": {
                "type": "object",
                "properties": {
                  "toolchainSelectionState": {
                    "const": "selected"
                  }
                },
                "required": [
                  "toolchainSelectionState"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executionOutcome": {
                "const": "publication-failure"
              }
            },
            "required": [
              "executionOutcome"
            ]
          },
          "then": {
            "properties": {
              "vectorId": {
                "enum": [
                  "failure.publication-invalidation",
                  "failure.publication-finalization"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "validationAttempt": {
      "type": "object",
      "required": [
        "workflow",
        "workflowRevision",
        "workflowRunId",
        "runAttempt",
        "validationExecutionSha",
        "hostRevision"
      ],
      "properties": {
        "workflow": {
          "$ref": "#/$defs/repositoryPath"
        },
        "workflowRevision": {
          "$ref": "#/$defs/sha256"
        },
        "workflowRunId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "validationExecutionSha": {
          "$ref": "#/$defs/commit"
        },
        "hostRevision": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "hostObservationFacts": {
      "type": "object",
      "required": [
        "sourceConfigurationId",
        "hostRevision",
        "contractBaselineSha256",
        "failureRegistrySha256",
        "calibratedBoundsSha256",
        "toolchainSelectionState",
        "normalizedDiagnosticFacts",
        "outputCommit",
        "measuredBounds",
        "loaderFact"
      ],
      "properties": {
        "sourceConfigurationId": {
          "type": "string",
          "pattern": "^source\\.[0-9a-f]{64}$"
        },
        "hostRevision": {
          "$ref": "#/$defs/commit"
        },
        "contractBaselineSha256": {
          "$ref": "#/$defs/sha256"
        },
        "failureRegistrySha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibratedBoundsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchainSelectionState": {
          "enum": [
            "not-selected",
            "selected"
          ]
        },
        "selectedSdk": {
          "$ref": "#/$defs/safeToken"
        },
        "selectedRuntime": {
          "$ref": "#/$defs/safeToken"
        },
        "selectedMsbuild": {
          "$ref": "#/$defs/safeToken"
        },
        "normalizedDiagnosticFacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/normalizedDiagnosticFact"
          }
        },
        "outputCommit": {
          "$ref": "#/$defs/outputCommitFact"
        },
        "measuredBounds": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/measuredBoundFact"
          }
        },
        "loaderFact": {
          "oneOf": [
            {
              "$ref": "#/$defs/loaderObservationFact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "toolchainSelectionState": {
                "const": "selected"
              }
            },
            "required": [
              "toolchainSelectionState"
            ]
          },
          "then": {
            "required": [
              "selectedSdk",
              "selectedRuntime",
              "selectedMsbuild"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "selectedSdk"
                  ]
                },
                {
                  "required": [
                    "selectedRuntime"
                  ]
                },
                {
                  "required": [
                    "selectedMsbuild"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "normalizedDiagnosticFact": {
      "type": "object",
      "required": [
        "code",
        "stage"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
          "maxLength": 96
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "outputCommitFact": {
      "type": "object",
      "required": [
        "status",
        "sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-committed",
            "staged",
            "committed"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "measuredBoundFact": {
      "type": "object",
      "required": [
        "name",
        "unit",
        "measured",
        "threshold",
        "enforcementClass"
      ],
      "properties": {
        "name": {
          "enum": [
            "diagnostic-count",
            "diagnostic-utf8-bytes",
            "temporary-disk-bytes",
            "toolchain-subprocess-count"
          ]
        },
        "unit": {
          "enum": [
            "bytes",
            "count"
          ]
        },
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "enforcementClass": {
          "enum": [
            "internally-enforceable",
            "observable-only"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "name": {
              "const": "diagnostic-count"
            },
            "unit": {
              "const": "count"
            },
            "enforcementClass": {
              "const": "internally-enforceable"
            }
          }
        },
        {
          "properties": {
            "name": {
              "const": "diagnostic-utf8-bytes"
            },
            "unit": {
              "const": "bytes"
            },
            "enforcementClass": {
              "const": "internally-enforceable"
            }
          }
        },
        {
          "properties": {
            "name": {
              "const": "temporary-disk-bytes"
            },
            "unit": {
              "const": "bytes"
            },
            "enforcementClass": {
              "const": "internally-enforceable"
            }
          }
        },
        {
          "properties": {
            "name": {
              "const": "toolchain-subprocess-count"
            },
            "unit": {
              "const": "count"
            },
            "enforcementClass": {
              "const": "observable-only"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "loaderObservationFact": {
      "type": "object",
      "required": [
        "code",
        "disposition",
        "selectedOrDefaultTargetFramework",
        "partialResultProduced"
      ],
      "properties": {
        "code": {
          "const": "loader.unsupported.multi-targeting"
        },
        "disposition": {
          "const": "whole-input-rejected"
        },
        "selectedOrDefaultTargetFramework": {
          "type": "boolean"
        },
        "partialResultProduced": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "canonicalResult": {
      "type": "object",
      "required": [
        "sha256",
        "byteCount",
        "encoding",
        "canonical"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "encoding": {
          "const": "canonical-json-utf8-no-bom-single-lf"
        },
        "canonical": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "commonSourceManifest": {
      "type": "object",
      "required": [
        "formatVersion",
        "bundleId",
        "subjectKind",
        "implementationOwner",
        "entryPointContract",
        "sourceConfiguration",
        "validationAttempt"
      ],
      "properties": {
        "formatVersion": {
          "const": "contractscribe-m1-host-validation-common-source-v1"
        },
        "bundleId": {
          "type": "string",
          "pattern": "^m1hvp1\\.[0-9a-f]{64}$"
        },
        "subjectKind": {
          "const": "production-host"
        },
        "implementationOwner": {
          "const": "issue-24"
        },
        "entryPointContract": {
          "const": "prebuilt-in-process-test-entrypoint"
        },
        "sourceConfiguration": {
          "$ref": "#/$defs/sourceConfiguration"
        },
        "validationAttempt": {
          "$ref": "#/$defs/validationAttempt"
        }
      },
      "additionalProperties": false
    },
    "cellSubjectManifest": {
      "type": "object",
      "required": [
        "formatVersion",
        "commonManifestSha256",
        "cellId",
        "subject"
      ],
      "properties": {
        "formatVersion": {
          "const": "contractscribe-m1-host-validation-cell-subject-v1"
        },
        "commonManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cellId": {
          "enum": [
            "ubuntu-x64",
            "windows-x64"
          ]
        },
        "subject": {
          "$ref": "#/$defs/executionCell"
        }
      },
      "additionalProperties": false
    }
  }
}
