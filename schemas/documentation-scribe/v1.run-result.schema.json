{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-scribe.dev/schemas/documentation-scribe/v1.run-result.schema.json",
  "title": "Documentation Scribe Run Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scribeRunResultVersion",
    "scribeRequestSha256",
    "attemptId",
    "terminal",
    "runEnvelope"
  ],
  "properties": {
    "scribeRunResultVersion": {
      "const": 1
    },
    "scribeRequestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "attemptId": {
      "$ref": "#/$defs/attemptId"
    },
    "terminal": {
      "$ref": "#/$defs/terminal"
    },
    "runEnvelope": {
      "$ref": "#/$defs/runEnvelope"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*[a-z0-9]$|^[a-z]$"
    },
    "componentIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9./-]*[a-z0-9]$|^[a-z]$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^scribe-attempt\\.[0-9a-f]{32}$"
    },
    "repositoryContextRef": {
      "type": "string",
      "pattern": "^repoctx-[0-9a-f]{32}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:]).+$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/repositoryPath"
                },
                "span": {
                  "$ref": "#/$defs/span"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata"
          ],
          "properties": {
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assemblyIdentity",
                "documentationCommentId"
              ],
              "properties": {
                "assemblyIdentity": {
                  "$ref": "#/$defs/identifier"
                },
                "documentationCommentId": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 512
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generatedOutput"
          ],
          "properties": {
            "generatedOutput": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "producerKind",
                "producerId",
                "outputId",
                "sourceSha256"
              ],
              "properties": {
                "producerKind": {
                  "enum": [
                    "source-generator",
                    "tool-generated"
                  ]
                },
                "producerId": {
                  "$ref": "#/$defs/identifier"
                },
                "outputId": {
                  "$ref": "#/$defs/identifier"
                },
                "sourceSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "span": {
                  "$ref": "#/$defs/span"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "synthetic"
          ],
          "properties": {
            "synthetic": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fixtureId"
              ],
              "properties": {
                "fixtureId": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      ]
    },
    "symbolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilationContextRef",
        "documentationCommentId"
      ],
      "properties": {
        "compilationContextRef": {
          "$ref": "#/$defs/identifier"
        },
        "documentationCommentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[A-Z]:.+$"
        }
      }
    },
    "resultTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryContextRef",
        "symbolRef",
        "sourceCommitment"
      ],
      "properties": {
        "repositoryContextRef": {
          "$ref": "#/$defs/repositoryContextRef"
        },
        "symbolRef": {
          "$ref": "#/$defs/symbolRef"
        },
        "sourceCommitment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "contentSha256"
          ],
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "contentSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "contentLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "evidenceReferenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "plainUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lines",
        "claimCategoryId",
        "evidenceReferenceIds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "content.remarks",
            "content.summary"
          ]
        },
        "lines": {
          "$ref": "#/$defs/contentLines"
        },
        "claimCategoryId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceReferenceIds": {
          "$ref": "#/$defs/evidenceReferenceIds"
        }
      }
    },
    "namedUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "componentIdentity",
        "name",
        "lines",
        "claimCategoryId",
        "evidenceReferenceIds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "content.parameter",
            "content.type-parameter"
          ]
        },
        "componentIdentity": {
          "$ref": "#/$defs/componentIdentity"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lines": {
          "$ref": "#/$defs/contentLines"
        },
        "claimCategoryId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceReferenceIds": {
          "$ref": "#/$defs/evidenceReferenceIds"
        }
      }
    },
    "componentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "componentIdentity",
        "lines",
        "claimCategoryId",
        "evidenceReferenceIds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "content.return",
            "content.value"
          ]
        },
        "componentIdentity": {
          "$ref": "#/$defs/componentIdentity"
        },
        "lines": {
          "$ref": "#/$defs/contentLines"
        },
        "claimCategoryId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceReferenceIds": {
          "$ref": "#/$defs/evidenceReferenceIds"
        }
      }
    },
    "exceptionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "typeDocumentationId",
        "lines",
        "claimCategoryId",
        "evidenceReferenceIds"
      ],
      "properties": {
        "kind": {
          "const": "content.exception"
        },
        "typeDocumentationId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^T:.+$"
        },
        "lines": {
          "$ref": "#/$defs/contentLines"
        },
        "claimCategoryId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceReferenceIds": {
          "$ref": "#/$defs/evidenceReferenceIds"
        }
      }
    },
    "inheritDocUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lines",
        "claimCategoryId",
        "evidenceReferenceIds"
      ],
      "properties": {
        "kind": {
          "const": "content.inherit-doc"
        },
        "lines": {
          "type": "array",
          "maxItems": 0
        },
        "claimCategoryId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceReferenceIds": {
          "$ref": "#/$defs/evidenceReferenceIds"
        }
      }
    },
    "contentUnit": {
      "oneOf": [
        {
          "$ref": "#/$defs/plainUnit"
        },
        {
          "$ref": "#/$defs/namedUnit"
        },
        {
          "$ref": "#/$defs/componentUnit"
        },
        {
          "$ref": "#/$defs/exceptionUnit"
        },
        {
          "$ref": "#/$defs/inheritDocUnit"
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "contentUnits"
      ],
      "properties": {
        "kind": {
          "const": "proposal"
        },
        "target": {
          "$ref": "#/$defs/resultTarget"
        },
        "contentUnits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/contentUnit"
          }
        }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "evidenceReferenceIds"
      ],
      "properties": {
        "kind": {
          "const": "skip"
        },
        "reason": {
          "enum": [
            "scribe.skip.insufficient-evidence",
            "scribe.skip.unsupported-current-m3-domain"
          ]
        },
        "evidenceReferenceIds": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code"
      ],
      "properties": {
        "kind": {
          "const": "failure"
        },
        "code": {
          "enum": [
            "scribe.failure.budget",
            "scribe.failure.internal",
            "scribe.failure.provider",
            "scribe.failure.timeout",
            "scribe.failure.tool-protocol",
            "scribe.failure.validation"
          ]
        }
      }
    },
    "cancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code"
      ],
      "properties": {
        "kind": {
          "const": "cancelled"
        },
        "code": {
          "enum": [
            "scribe.cancelled.caller",
            "scribe.cancelled.shutdown"
          ]
        }
      }
    },
    "terminal": {
      "oneOf": [
        {
          "$ref": "#/$defs/proposal"
        },
        {
          "$ref": "#/$defs/skip"
        },
        {
          "$ref": "#/$defs/failure"
        },
        {
          "$ref": "#/$defs/cancelled"
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currencyId",
        "amountMicrounits"
      ],
      "properties": {
        "currencyId": {
          "$ref": "#/$defs/identifier"
        },
        "amountMicrounits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "stage"
          ],
          "properties": {
            "code": {
              "const": "scribe.diagnostic.provider-failure"
            },
            "stage": {
              "const": "provider"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "stage",
            "referenceId"
          ],
          "properties": {
            "code": {
              "const": "scribe.diagnostic.tool-failure"
            },
            "stage": {
              "const": "tool"
            },
            "referenceId": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "stage",
            "validationCode"
          ],
          "properties": {
            "code": {
              "const": "scribe.diagnostic.result-rejected"
            },
            "stage": {
              "const": "result"
            },
            "validationCode": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "stage"
          ],
          "properties": {
            "code": {
              "const": "scribe.diagnostic.runtime-failure"
            },
            "stage": {
              "const": "runtime"
            }
          }
        }
      ]
    },
    "runEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scribeRequestSha256",
        "attemptId",
        "providerConfigurationId",
        "modelConfigurationId",
        "scribeProtocolId",
        "toolPolicyId",
        "styleProfileId",
        "attemptNumber",
        "providerRequestCount",
        "toolRoundCount",
        "toolCallCount",
        "elapsedMilliseconds",
        "diagnostics"
      ],
      "properties": {
        "scribeRequestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "attemptId": {
          "$ref": "#/$defs/attemptId"
        },
        "providerConfigurationId": {
          "$ref": "#/$defs/identifier"
        },
        "modelConfigurationId": {
          "$ref": "#/$defs/identifier"
        },
        "scribeProtocolId": {
          "$ref": "#/$defs/identifier"
        },
        "toolPolicyId": {
          "$ref": "#/$defs/identifier"
        },
        "styleProfileId": {
          "$ref": "#/$defs/identifier"
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1
        },
        "providerRequestCount": {
          "type": "integer",
          "minimum": 0
        },
        "toolRoundCount": {
          "type": "integer",
          "minimum": 0
        },
        "toolCallCount": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "cacheObservation": {
          "enum": [
            "cache.hit",
            "cache.miss",
            "cache.mixed",
            "cache.not-reported"
          ]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    }
  }
}
