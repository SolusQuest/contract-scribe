<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="solusagent" value="https://nuget.pkg.github.com/SolusQuest/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="solusagent">
      <package pattern="SolusAgent.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
